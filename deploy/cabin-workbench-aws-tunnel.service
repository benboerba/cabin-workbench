[Unit]
Description=Cabin Workbench AWS tunnel to bobjennies.click gateway
After=network-online.target cabin-workbench.service
Wants=network-online.target
Requires=cabin-workbench.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
ExecStart=/usr/bin/ssh -NT \
    -i /home/ec2-user/.ssh/cabin-workbench-gateway-ed25519 \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile=/home/ec2-user/.ssh/cabin-workbench-gateway-known-hosts \
    -R 127.0.0.1:14271:127.0.0.1:4270 \
    root@38.181.56.160
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
