# Absolute path recommended in production. The directory must be writable by
# the service user. Never commit the real database file.
DATABASE_PATH=/home/ec2-user/data/cabin-workbench/oneminute.db

# Keep true when the public site uses HTTPS. Set false only for local HTTP.
COOKIE_SECURE=true

# Comma-separated usernames allowed to register. Keep the production list in
# the server environment file, not in the public repository.
REGISTRATION_USERNAMES=alice,friend2
